{
	"name": "obsidian-workspace-organizer",
	"version": "0.1.0",
	"description": "Tag, archive, reorder, and search your Obsidian workspaces",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck -p tsconfig.json && tsc -noEmit -skipLibCheck -p tsconfig.test.json",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src test --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.2.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"obsidian": "^1.13.1",
		"prettier": "3.9.6",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
